<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Form View -->
    <record id="library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Library books">
                <header>
                    <button name="make_available" string="Make Available" type="object"
                        class="btn-primary" />
                    <button name="make_borrowed" string="Make Borrowed" type="object"
                        class="btn-primary" />
                    <button name="make_lost" string="Make Lost" type="object" class="btn-danger" />
                    <button name="book_rent" string="Rent this book" type="object"
                        class="btn-primary" />
                    <button name="average_book_occupation" string="Log Average Occ." type="object"
                        class="btn-primary" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="cover" widget="image" class="oe_avatar" />
                            <field name="name" />
                            <field name="short_name" />
                            <widget name="web_ribbon" title="Out of Print" bg_color="bg-danger"
                                invisible="out_of_print == False" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Book Info">
                            <group string="About the Book" name="about_book">
                                <field name="author_ids" widget="many2many_tags" />
                                <field name="category_id" />
                                <field name="date_released" />
                                <field name="pages" />
                            </group>
                            <group string="Publication" name="publication">
                                <field name="publisher_id" />
                                <field name="publisher_city" />
                                <field name="out_of_print" />
                                <field name="description" />
                                <field name="reader_rating" />
                            </group>
                        </page>
                        <page string="Library Management" groups="my_library.group_librarians">
                            <group string="Cost and Pricing" name="cost_pricing">
                                <field name="currency_id" />
                                <field name="cost_price" />
                                <field name="retail_price" />
                            </group>
                            <group string="Internal" name="internal">
                                <field name="notes" />
                                <field name="manager_remarks" />
                            </group>
                            <group string="Tracking" name="tracking">
                                <field name="date_updated" />
                                <field name="age_days" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'lost'">
                <field name="name" />
                <field name="date_released" />
                <field name="author_ids" widget="many2many_tags" />
                <field name="publisher_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="author_ids" />
                <filter string="No Authors" name="without_author"
                    domain="[('author_ids','=',False)]" />
            </search>
        </field>
    </record>
</odoo>