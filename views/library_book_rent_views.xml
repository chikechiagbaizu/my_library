<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Form View -->
    <record id="library_book_rent_form" model="ir.ui.view">
        <field name="name">library.book.rent.form</field>
        <field name="model">library.book.rent</field>
        <field name="arch" type="xml">
            <form string="Book rent">
                <header>
                    <button name="book_lost" string="Mark Lost" type="object" class="btn-primary" />
                </header>
                <sheet>
                    <group>
                        <field name="book_id" />
                        <field name="borrower_id" />
                        <field name="state" />
                        <field name="rent_date" />
                        <field name="return_date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="library_book_rent_list" model="ir.ui.view">
        <field name="name">library.book.rent.list</field>
        <field name="model">library.book.rent</field>
        <field name="arch" type="xml">
            <list>
                <field name="book_id" />
                <field name="borrower_id" />
                <field name="state" />
                <field name="rent_date" />
                <field name="return_date" />
            </list>
        </field>
    </record>
</odoo>